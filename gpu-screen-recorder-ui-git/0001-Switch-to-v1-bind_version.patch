From 31ca552ef650b342519d0f785d916dbb98cbb3e8 Mon Sep 17 00:00:00 2001
From: Dreaght <dreaght@icloud.com>
Date: Thu, 14 May 2026 10:42:16 +0300
Subject: [PATCH] Switch to v1 bind_version as v3 features are not yet
 implemented

Signed-off-by: Dreaght <dreaght@icloud.com>
---
 src/window/wayland.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/window/wayland.c b/src/window/wayland.c
index 8ad1dba..a9eac4b 100644
--- a/src/window/wayland.c
+++ b/src/window/wayland.c
@@ -1502,7 +1502,7 @@ static void registry_add_object(void *data, struct wl_registry *registry,
            the lifetime of the wl_display — see mgl_wayland_clipboard_state
            comment. Bind once. */
         if(!g_clipboard.manager) {
-            const uint32_t bind_version = (version < 3) ? version : 3;
+            const uint32_t bind_version = 1;
             g_clipboard.manager = wl_registry_bind(registry, name,
                 &wl_data_device_manager_interface, bind_version);
         }
-- 
