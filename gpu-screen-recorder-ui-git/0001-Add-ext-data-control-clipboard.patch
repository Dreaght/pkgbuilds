diff --git a/include/Clipboard/Clipboard.hpp b/include/Clipboard/Clipboard.hpp
new file mode 100644
index 0000000..b5d9f70
--- /dev/null
+++ b/include/Clipboard/Clipboard.hpp
@@ -0,0 +1,21 @@
+#pragma once
+
+#include <string>
+
+namespace gsr {
+    class Clipboard {
+    public:
+        enum class FileType {
+            JPG,
+            PNG
+        };
+
+        Clipboard() = default;
+        virtual ~Clipboard() = default;
+        Clipboard(const Clipboard&) = delete;
+        Clipboard& operator=(const Clipboard&) = delete;
+
+        // Set this to an empty string to unset clipboard
+        virtual void set_current_file(const std::string &filepath, FileType file_type) = 0;
+    };
+}
