# Maintainer:

_pkgname="gpu-screen-recorder-ui"
pkgname="$_pkgname-git"
pkgver=1.12.0.r1.ga4e3f58
pkgrel=1
pkgdesc="A fullscreen overlay UI for GPU Screen Recorder in the style of ShadowPlay"
url="https://git.dec05eba.com/gpu-screen-recorder-ui"
license=('GPL-3.0-only')
arch=('x86_64')

depends=(
  'dbus'
  'libdrm'
  'libglvnd'
  'libpulse'
  'libx11'
  'libxcomposite'
  'libxcursor'
  'libxext'
  'libxfixes'
  'libxi'
  'libxrandr'
  'libxrender'
  'pango'
  'wayland'
)
makedepends=(
  'desktop-file-utils'
  'git'
  'meson'
)

provides=("$_pkgname")
conflicts=("$_pkgname")

_pkgsrc="$_pkgname"
source=("$_pkgsrc"::"git+$(sed 's&//git\.&//repo.&' <<< "$url")"
	"mglpp"::"git+https://repo.dec05eba.com/mglpp"
	"mgl"::"git+https://repo.dec05eba.com/mgl"
	"0001-Add-ext-data-control-clipboard.patch"
	"0001-Switch-to-v1-bind_version.patch")
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'd4e809c66e00297d01b671ecdd5fa354b7a10cbba5930719e327604d56924400'
            'b4f72c7dc79b44998ff80df475777a6f65f27df0e0d677095404943c1b6875bd')

prepare() {
    local desired_mglpp_rev desired_mgl_rev

    desired_mglpp_rev=$(git -C "${srcdir}/${_pkgsrc}" ls-tree HEAD depends/mglpp | awk '{print $3}')
    if [[ -n "$desired_mglpp_rev" ]]; then
        git -C "${srcdir}/mglpp" checkout --force "$desired_mglpp_rev"
    fi

    rm -rf "${srcdir}/${_pkgsrc}/depends/mglpp"
    cp -a "${srcdir}/mglpp" "${srcdir}/${_pkgsrc}/depends/mglpp"

    desired_mgl_rev=$(git -C "${srcdir}/${_pkgsrc}/depends/mglpp" ls-tree HEAD depends/mgl | awk '{print $3}')
    if [[ -n "$desired_mgl_rev" ]]; then
        git -C "${srcdir}/mgl" checkout --force "$desired_mgl_rev"
    fi

    rm -rf "${srcdir}/${_pkgsrc}/depends/mglpp/depends/mgl"
    cp -a "${srcdir}/mgl" "${srcdir}/${_pkgsrc}/depends/mglpp/depends/mgl"

    patch \
        --forward \
        --strip=1 \
        -d "${srcdir}/${_pkgsrc}" \
        --input="${srcdir}/0001-Add-ext-data-control-clipboard.patch"

    patch \
        --forward \
        --strip=1 \
        -d "${srcdir}/${_pkgsrc}/depends/mglpp/depends/mgl" \
        --input="${srcdir}/0001-Switch-to-v1-bind_version.patch"
}

pkgver() {
  cd "$_pkgsrc"
  git describe --long --tags --abbrev=7 --exclude='*[a-zA-Z][a-zA-Z]*' \
    | sed -E 's/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g'
}

build() {
  arch-meson "$_pkgsrc" build
  meson compile -C build
}

package() {
  depends+=(
    'gpu-screen-recorder'
    'gpu-screen-recorder-notification'
  )
  meson install -C build --destdir "$pkgdir"
}
